# GeneLabs CTI Workbench — local environment
#
# Copy to .env and fill in. That file is gitignored.
#
#   Copy-Item .env.example .env
#
# No credentials belong here. Only the vault URL and non-secret routing:
# the vault holds every actual secret, and scripts/fetch_secrets.py reads
# them from it at run time.

# ---------------------------------------------------------------------------
# Azure Key Vault
# ---------------------------------------------------------------------------
# The vault the MCP launchers and scripts/fetch_secrets.py read from.
# Authentication is the ambient `az login` session via DefaultAzureCredential,
# so no client id or secret is needed here.
#
# Find it with:  az keyvault show --name <vault-name> --query "properties.vaultUri" --output tsv
KEY_VAULT_URL=https://<your-keyvault>.vault.azure.net/

# ---------------------------------------------------------------------------
# Provider routing — managed by switch_provider.ps1
# ---------------------------------------------------------------------------
# Leave these commented for enterprise mode, which uses the Claude SSO login
# and needs nothing here. `.\switch_provider.ps1 bedrock` uncomments them and
# `.\switch_provider.ps1 enterprise` comments them back.
#
# Edit them by hand only if you are not using the toggle script.

#CLAUDE_CODE_USE_BEDROCK=1
#AWS_REGION=us-east-1
#ANTHROPIC_MODEL=us.anthropic.claude-opus-5
#ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Teams or Slack incoming webhook. Without it a run summary reaches you only
# as a desktop toast and a file on disk.
#CTI_NOTIFY_WEBHOOK=
